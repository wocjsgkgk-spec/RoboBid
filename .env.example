# RoboBid AI — Environment Variables Template

# Supabase (Public - Client Side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase (Private - Server Side Only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3005

# Public Data Portal API Keys (P0 Providers)
DATA_GO_KR_SERVICE_KEY=your-data-go-kr-service-key
BIZINFO_API_KEY=your-bizinfo-api-key

# Telegram Bot (MVP Notifications)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_DEFAULT_CHAT_ID=your-telegram-chat-id

# AI Providers (Confidential / Public Separation)
# Tier 1: Public RFP Analysis
GEMINI_API_KEY=your-gemini-api-key

# Tier 2: Confidential Company Data Analysis (Zero Retention Policy)
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
