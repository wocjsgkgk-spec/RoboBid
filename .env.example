# ==============================================================================
# RoboBid AI — Environment Variables Template (.env.example)
# ==============================================================================

# 1. Supabase (Database & Auth)
# URL: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App Base URL (로컬 개발: http://localhost:3005 / Vercel 배포 시: https://your-domain.vercel.app)
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# 2. Public Data Portal & Grants (공공조달/지원사업 - 무료)
# 공공데이터포털 (조달청 나라장터, K-Startup): https://www.data.go.kr
DATA_GO_KR_SERVICE_KEY=your-data-go-kr-service-key
# 기업마당 OpenAPI: https://www.bizinfo.go.kr/uss/openapi/bizinfoApi.do
BIZINFO_API_KEY=your-bizinfo-api-key
# 범부처통합연구지원시스템 IRIS: https://www.iris.go.kr
IRIS_API_KEY=
# 중소기업기술정보진흥원 TIPA: https://www.smtech.go.kr
TIPA_API_KEY=

# 3. AI Providers (LLM)
# Google Gemini (무료 티어 제공): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# OpenAI GPT-4o (유료 종량제): https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude 3.5 (유료 종량제): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Groq (초고속 무료 티어): https://console.groq.com/keys
GROQ_API_KEY=

# Upstage Solar (한국어 특화 무료 크레딧): https://console.upstage.ai/api-keys
UPSTAGE_API_KEY=

# 4. Local Air-Gapped LLM (Ollama - 영구 무료, 로컬 환경 전용)
# URL: https://ollama.com/download
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3:8b

# 5. Telegram Notifications (영구 무료 실시간 알림)
# Bot Token: Telegram @BotFather 에서 발급받은 토큰
TELEGRAM_BOT_TOKEN=
# Chat ID: Telegram @userinfobot 또는 @getidsbot 에서 확인한 본인/단톡방 ID
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_CHAT_ID=

